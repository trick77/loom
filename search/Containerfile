# syntax=docker/dockerfile:1
# Web search sidecar for loom (docs/search.md). Build from the repository root:
#   docker build -f search/Containerfile -t loom-search .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-search/ ./cmd/loom-search/
# The token rule loom checks its side with and the bearer-token root. The MCP
# server is github.com/trick77/toolkit's.
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. go build fetches only the modules
# this binary imports, not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-search ./cmd/loom-search

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-search /loom-search
# Stateless: no /data. The nonroot uid, never 1000.
USER 65532:65532
EXPOSE 8030
ENTRYPOINT ["/loom-search"]
CMD ["serve"]
