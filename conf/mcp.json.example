{
  "_comment": "Extra MCP servers in the standard mcpServers format. Copy this to conf/mcp.json (the path in BACKEND_MCP_SERVERS_FILE, default /conf/mcp.json). Servers here merge on top of the built-ins and override any built-in of the same name. Keep secrets out of this file: ${VAR} is interpolated from the backend process environment at startup. Each entry's ${VAR} must be set — a present entry with an unset var fails startup, so delete any server you are not using. 'type' is 'http' (Streamable HTTP, default) or 'stdio'.",
  "_comment_categories": "Optional 'categories' gates a server's tools to matching conversation categories so they are only injected into the prompt on relevant turns (reducing tool bloat). Omit it to make a server always available. Values are classifier categories: knowledge_discovery, academic_research, recent_news, science_math, coding, cooking_recipes, creative_writing, how_to, shopping, writing_editing, summarization, brainstorming, planning, weather, translation, url_lookup.",
  "_comment_users": "Optional 'users' limits a server to these loom accounts, by loom user id (the 'id' GET /api/me returns) — never the username, which the identity provider can change. An array, or one comma-separated string (so a ${VAR} can carry the list). Use it for a server that reads one person's data. Present but empty (or null) means nobody; absent means everyone.",
  "_comment_trust": "Optional 'trustInstructions': true puts the server's own instructions (server/discover or initialize) into the system prompt whenever its tools are offered. Leave it off for third-party servers.",
  "_comment_sources": "A tool result whose structuredContent is {\"sources\":[{\"url\",\"title\",\"label\",\"snippet\",\"image\"}]} feeds loom's sources sidebar and [n] citations. List results unnumbered, in sources order: loom prepends 'Source [n]: title — url' lines, the only numbering the model should see.",
  "mcpServers": {
    "peeq": {
      "type": "http",
      "url": "${PEEQ_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${PEEQ_MCP_TOKEN}"
      },
      "users": "${BACKEND_PEEQ_USERS}",
      "trustInstructions": true
    },
    "ipverse": {
      "type": "http",
      "url": "https://gateway.ipverse.net/mcp",
      "headers": {
        "Authorization": "Bearer ${IPVERSE_API_KEY}"
      },
      "categories": ["coding", "knowledge_discovery"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "categories": ["coding", "how_to"]
    }
  }
}
