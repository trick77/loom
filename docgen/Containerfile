# syntax=docker/dockerfile:1
# Document tools sidecar for loom (docs/docgen.md). Build from the repository root:
#   docker build -f docgen/Containerfile -t loom-docgen .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-docgen/ ./cmd/loom-docgen/
# The generators and the Gotenberg client, with their embedded fonts
# (internal/docgen/assets). The MCP server is github.com/trick77/toolkit's.
COPY backend/internal/docgen/ ./internal/docgen/
# The token rule loom checks its side with and the bearer-token root.
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. go build fetches only the modules
# this binary imports, not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-docgen ./cmd/loom-docgen

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-docgen /loom-docgen
# Stateless: no /data. The nonroot uid, never 1000.
USER 65532:65532
EXPOSE 8020
ENTRYPOINT ["/loom-docgen"]
CMD ["serve"]
