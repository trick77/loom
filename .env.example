# Hostname Traefik routes loom on (compose.yaml Host rule). Required by compose.
# The only place the host is set: loom's public URL is https://<PUBLIC_FQDN>.
PUBLIC_FQDN=loom.example.com

# Session secret
# Signs the session cookies, at least 32 characters: openssl rand -hex 32. Changing it signs everyone out.
BACKEND_SESSION_SECRET=change-me-to-a-long-random-string
# How long a login stays valid (Go duration). Group membership is recomputed at login.
# BACKEND_SESSION_TTL=720h

# Authentication
BACKEND_AUTH_MODE=oidc
BACKEND_OIDC_ISSUER=https://auth.example.com/application/o/loom/
BACKEND_OIDC_CLIENT_ID=
BACKEND_OIDC_CLIENT_SECRET=
BACKEND_OIDC_REDIRECT_URL=https://loom.example.com/api/auth/callback
BACKEND_OIDC_POST_LOGOUT_REDIRECT_URL=https://loom.example.com/
BACKEND_OIDC_ADMIN_GROUP=loom-admins

# Compose loads this file whole into the container: the model ids and keys
# below must be here, values exported in the shell are not forwarded.
#
# Chat models: llmwire registry ids. Swapping a model is these lines plus the
# key its provider reads; everything else about the model (host, reasoning
# control, limits, rates, display name) is its llmwire profile. Boot lists the
# valid ids when one is unknown or lacks what its role needs. Required outside
# dev auth.
BACKEND_CHAT_MODEL=glm-5.3-flash
# Short gates (titles, classification, image intent). Default: the chat model.
# BACKEND_GATE_MODEL=
# Image turns and image description; must accept images. Default: the chat model.
# BACKEND_VISION_MODEL=
# Optional second model the composer offers per thread ("thinks longer"), run
# at its profile's deep reasoning level. Its key is optional: unset, the choice
# is hidden and chat stays on. Unset or off: no choice.
# BACKEND_DEEP_CHAT_MODEL=claude-fable-5-2
# LLMWIRE_ANTHROPIC_API_KEY=
# Keys: LLMWIRE_<PROVIDER>_API_KEY for the provider each model's profile names
# (boot names any that are missing). Same names in every app on llmwire, so
# one .env serves all of them.
LLMWIRE_ZAI_API_KEY=
# The completion cap of a chat turn counts reasoning AND answer.
BACKEND_CHAT_MAX_COMPLETION_TOKENS=16384
BACKEND_CHAT_TIMEOUT=4m
# Abort a chat stream that goes silent after this idle window (0 disables). The
# window is armed at request entry and only a data: frame resets it, so it must
# clear an upstream's first-token queue wait, while staying below
# BACKEND_CHAT_TIMEOUT.
BACKEND_CHAT_IDLE_TIMEOUT=120s
# Present every llmwire request, embeddings included, as the opencode client
# (User-Agent and session headers), for a host sold as opencode's backend.
# Read by llmwire, process-wide: it only changes hosts the profiles do not
# already mark. Adds the identity, never removes it.
LLMWIRE_EMULATE_OPENCODE=true

# Embeddings (document RAG): an llmwire embedding model id plus the key its
# provider reads. Changing it rebuilds the vector table at boot and re-embeds
# every document in the background
# (logged, and billed as embedding usage); retrieval finds a document again
# once its vectors are back.
BACKEND_EMBED_MODEL=text-embedding-3-small
LLMWIRE_OPENAI_API_KEY=sk-...

# Image generation (loom-imagegen sidecar, docs/imagegen.md). Opt-in: add
# imagegen to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=imagegen,tunewire) and set
# the URL, the token and the fal key. An mcp.json server named imagegen replaces
# the sidecar.
# BACKEND_IMAGE_GEN_URL=http://imagegen:8040  # compose.dev.yaml (host network): http://localhost:8040
# BACKEND_IMAGE_GEN_TOKEN=          # shared with the sidecar, at least 32 characters: openssl rand -hex 32
# The sidecar's own settings (compose hands them to it; loom never reads them):
# BACKEND_IMAGE_GEN_API_KEY=       # fal API key
# BACKEND_IMAGE_GEN_MODEL=fal-ai/flux-2-pro
# Used instead for a thread's first image when it must carry legible text
# (logo, sign, poster); the thread keeps its first model. off: every image on
# the model above.
# BACKEND_IMAGE_GEN_TYPOGRAPHY_MODEL=fal-ai/flux-2-max
# BACKEND_IMAGE_GEN_BASE_URL=https://queue.fal.run
# BACKEND_IMAGE_GEN_POLL_TIMEOUT=1m  # at most 2m30s

# Web search (loom-search sidecar, docs/search.md), always started by
# compose.yaml. The token is required: loom and the sidecar refuse to start
# without one. An mcp.json server named search replaces the sidecar.
# Shared with the sidecar, at least 32 characters: openssl rand -hex 32.
BACKEND_SEARCH_TOKEN=
# BACKEND_SEARCH_URL=http://search:8030  # compose.dev.yaml (host network): http://localhost:8030
# Tavily API key, the sidecar's alone (compose hands it to it; loom only sees
# whether it is set). Empty: the sidecar serves no tool, web search is off.
BACKEND_TAVILY_API_KEY=

# Weather (loom-weather sidecar, docs/weather.md), always started by
# compose.yaml: forecasts for weather questions, no provider key. Empty token:
# the weather is off. An mcp.json server named weather replaces the sidecar.
# Shared with the sidecar, at least 32 characters: openssl rand -hex 32.
BACKEND_WEATHER_TOKEN=
# BACKEND_WEATHER_URL=http://weather:8100  # compose.dev.yaml (host network): http://localhost:8100; off disables it

# Product search (loom-shop sidecar, docs/shop.md), always started by
# compose.yaml: a shop's catalog for shopping questions, no provider key, shown
# as product cards. Empty token: product search is off. An mcp.json server
# named shop replaces the sidecar.
# Shared with the sidecar, at least 32 characters: openssl rand -hex 32.
BACKEND_SHOP_TOKEN=
# BACKEND_SHOP_URL=http://shop:8110  # compose.dev.yaml (host network): http://localhost:8110; off disables it

# Document tools (loom-docgen sidecar, docs/docgen.md), always started by
# compose.yaml; it renders PDFs with the gotenberg service. The token is
# required: loom and the sidecar refuse to start without one. An mcp.json
# server named docgen replaces the sidecar.
# Shared with the sidecar, at least 32 characters: openssl rand -hex 32.
BACKEND_DOCGEN_TOKEN=
# BACKEND_DOCGEN_URL=http://docgen:8020  # compose.dev.yaml (host network): http://localhost:8020

# MCP sidecars (fetch runs in-process; only obscura is an external sidecar)
BACKEND_OBSCURA_MCP_URL=http://obscura:8090/mcp
# Shared by loom and obscura, required with the URL: obscura refuses MCP beyond
# loopback without one. At least 32 characters: openssl rand -hex 32.
BACKEND_OBSCURA_MCP_TOKEN=

# Python sandbox for the run_python tool (loom-sandbox sidecar, started by
# compose like the others; nothing to install on the host). Optional shared
# token between loom and the sidecar: openssl rand -hex 32.
# BACKEND_SANDBOX_TOKEN=
# Longest a single job may run (at most 60s).
# BACKEND_SANDBOX_TIMEOUT=60s

# Apple Music (loom-tunewire sidecar, docs/tunewire.md). Opt-in: uncomment all
# of these. USERS (loom user ids from /api/me, comma-separated) is required: only
# they get the playlist tools and the settings section, each with their own Apple
# Music account (never shared); catalog search (Apple Music links) is open to everyone.
# COMPOSE_PROFILES=tunewire
# BACKEND_TUNEWIRE_URL=http://tunewire:8060  # compose.dev.yaml (host network): http://localhost:8060
# BACKEND_TUNEWIRE_TOKEN=          # shared with the sidecar, at least 32 characters: openssl rand -hex 32
# BACKEND_TUNEWIRE_USERS=
# TUNEWIRE_STOREFRONT=ch           # catalog search country (two letters)

# Strava (loom-strava sidecar, docs/strava.md). Opt-in: uncomment all of these
# (add strava to COMPOSE_PROFILES). USERS (loom user ids from /api/me,
# comma-separated) is required: only they get the Strava tools and settings
# section, each with their own Strava account (never shared). CLIENT_ID and
# _SECRET are your Strava API app's (strava.com/settings/api); its
# Authorization Callback Domain is PUBLIC_FQDN.
# COMPOSE_PROFILES=strava
# BACKEND_STRAVA_URL=http://strava:8050  # compose.dev.yaml (host network): http://localhost:8050
# BACKEND_STRAVA_TOKEN=            # shared with the sidecar, at least 32 characters: openssl rand -hex 32
# BACKEND_STRAVA_USERS=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Extra MCP servers from a JSON file (standard mcpServers format; see conf/mcp.json.example).
# Compose mounts ./conf at /conf; copy the example to conf/mcp.json. Absent file is a no-op.
# Merged on top of the built-ins; use ${VAR} in the file for secrets.
BACKEND_MCP_SERVERS_FILE=/conf/mcp.json
# Tokens referenced by conf/mcp.json's ${VAR} placeholders (secondary, best-effort MCP servers).
# No BACKEND_ prefix — the file reads raw process env. Leave blank only if you also remove the
# matching server entry from conf/mcp.json (a present entry with an unset var fails startup).
# IPVERSE_API_KEY: ipverse-lens whois; shares the same monthly quota as ipverse API requests.
IPVERSE_API_KEY=
# CONTEXT7_API_KEY: Context7 documentation tools (context7__resolve-library-id, context7__query-docs).
CONTEXT7_API_KEY=
# peeq video library (the "peeq" entry in conf/mcp.json): transcripts, summaries and search.
# PEEQ_MCP_URL is peeq's endpoint, e.g. https://peeq.example.com/mcp. PEEQ_MCP_TOKEN is the same
# value as peeq's BACKEND_MCP_TOKEN (create it with: openssl rand -base64 32).
# BACKEND_PEEQ_USERS: comma-separated loom user ids (the "id" from GET /api/me) that get the peeq
# tools; empty = nobody. Usernames do not count: the IdP can change them.
PEEQ_MCP_URL=
PEEQ_MCP_TOKEN=
BACKEND_PEEQ_USERS=

# Log verbosity: debug | info | warn | error (default info).
# BACKEND_LOG_LEVEL=info

# Local development without OIDC:
# BACKEND_AUTH_MODE=dev
# BACKEND_ADDR=127.0.0.1:8080   (public URL becomes http://<BACKEND_ADDR>; PUBLIC_FQDN is ignored)
