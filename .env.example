# Public URL and session secret
BACKEND_PUBLIC_URL=https://loom.example.com
BACKEND_SESSION_SECRET=change-me-to-a-long-random-string
# How long a login stays valid (Go duration). Group membership is recomputed at login.
# BACKEND_SESSION_TTL=720h

# Authentication
BACKEND_AUTH_MODE=oidc
BACKEND_OIDC_ISSUER=https://auth.example.com/application/o/loom/
BACKEND_OIDC_CLIENT_ID=
BACKEND_OIDC_CLIENT_SECRET=
BACKEND_OIDC_REDIRECT_URL=https://loom.example.com/api/auth/callback
BACKEND_OIDC_POST_LOGOUT_REDIRECT_URL=https://loom.example.com/
BACKEND_OIDC_ADMIN_GROUP=loom-admins

# Model endpoints belong to llmwire: each model's profile names a provider
# and ships its host, and the client reads the key from
# LLMWIRE_<PROVIDER>_API_KEY at boot. Same names in every app on llmwire, so
# one .env serves all of them. A set key turns the capability on.
# Chat: Z.ai's GENERAL (pay-as-you-go) host, carried by llmwire's profile. A
# GLM Coding Plan key does not work: that plan is restricted to Z.ai's own
# tools.
LLMWIRE_ZAI_API_KEY=
# The model is hardcoded and not configurable: glm-5.3-flash for every chat
# call — text turns, image turns, the short gates and the prose helpers.
# It always thinks; thinking cannot be switched off (the toggle is refused), so
# depth is steered by reasoning_effort alone: "high" on a normal turn (unset
# means the vendor's "max", measured ~5x slower), "low" on the helper calls
# and the forced final answer.
# The completion cap counts reasoning AND answer, so a low cap can end a chat
# turn with reasoning only and no answer.
BACKEND_CHAT_MAX_COMPLETION_TOKENS=16384
BACKEND_CHAT_TIMEOUT=4m
# Abort a chat stream that goes silent after this idle window (0 disables). The
# window is armed at request entry and only a data: frame resets it, so it must
# clear an upstream first-token queue wait (MiMo's exceeded 60s under load),
# while staying below BACKEND_CHAT_TIMEOUT.
BACKEND_CHAT_IDLE_TIMEOUT=120s
# Present every llmwire request, embeddings included, as the opencode client
# (User-Agent and session headers), for a host sold as opencode's backend.
# Read by llmwire, process-wide: it only changes hosts the profiles do not
# already mark (Z.ai's general host and OpenAI are not marked, and accept
# it). Adds the identity, never removes it.
LLMWIRE_EMULATE_OPENCODE=true

# Embeddings: OpenAI text-embedding-3-small (a constant of the build; the
# vector column width is fixed by the migration that created it).
LLMWIRE_OPENAI_API_KEY=sk-...

# Image generation
BACKEND_IMAGE_GEN_BASE_URL=https://queue.fal.run
BACKEND_IMAGE_GEN_API_KEY=
BACKEND_IMAGE_GEN_MODEL=fal-ai/flux-2-pro
# Used instead of BACKEND_IMAGE_GEN_MODEL for the first image of a thread when the
# request reads as typography/logo/text work (FLUX.2 [max] renders legible text
# far better than [pro]). The choice is locked per thread. Leave empty to disable
# typography routing (every image stays on BACKEND_IMAGE_GEN_MODEL).
BACKEND_IMAGE_GEN_TYPOGRAPHY_MODEL=fal-ai/flux-2-max
BACKEND_IMAGE_GEN_POLL_TIMEOUT=1m

# Tavily web search
BACKEND_TAVILY_URL=https://mcp.tavily.com/mcp/
BACKEND_TAVILY_API_KEY=

# MCP sidecars (fetch runs in-process; only obscura is an external sidecar)
BACKEND_OBSCURA_MCP_URL=http://obscura:8090/mcp

# Extra MCP servers from a JSON file (standard mcpServers format; see conf/mcp.json.example).
# Compose mounts ./conf at /conf; copy the example to conf/mcp.json. Absent file is a no-op.
# Merged on top of the built-ins; use ${VAR} in the file for secrets.
BACKEND_MCP_SERVERS_FILE=/conf/mcp.json
# Tokens referenced by conf/mcp.json's ${VAR} placeholders (secondary, best-effort MCP servers).
# No BACKEND_ prefix — the file reads raw process env. Leave blank only if you also remove the
# matching server entry from conf/mcp.json (a present entry with an unset var fails startup).
# IPVERSE_API_KEY: ipverse-lens whois; shares the same monthly quota as ipverse API requests.
IPVERSE_API_KEY=
# CONTEXT7_API_KEY: Context7 documentation tools (context7__resolve-library-id, context7__query-docs).
CONTEXT7_API_KEY=

# Log verbosity: debug | info | warn | error (default info).
# BACKEND_LOG_LEVEL=info

# Local development without OIDC:
# BACKEND_AUTH_MODE=dev
# BACKEND_ADDR=127.0.0.1:8080
# BACKEND_PUBLIC_URL=http://localhost:8080
