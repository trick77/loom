# syntax=docker/dockerfile:1
# Code sandbox for loom's run_python tool. Build from the repository root:
#   docker build -f sandbox/Containerfile -t loom-sandbox .
# A plain container (default runtime, nothing on the host); see compose.yaml.

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-sandbox/ ./cmd/loom-sandbox/
# ship release passes the release version. go build fetches only the modules
# this binary imports (golang.org/x/sys and kit), not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-sandbox ./cmd/loom-sandbox

# The UI's sans as static TTFs for the charts (sandbox/fonts.py). Only the TTFs
# reach the final image, so fonttools and brotli stay out of the release scan.
FROM python:3.15-slim AS fonts
RUN pip install --no-cache-dir --root-user-action=ignore fonttools brotli
COPY ui/src/fonts/SansWebVariable-TextRegular.woff2 sandbox/fonts.py /tmp/
RUN python /tmp/fonts.py /tmp/SansWebVariable-TextRegular.woff2 /out/fonts

FROM python:3.15-slim
# upgrade: the base image lags Debian's security fixes, and the release's trivy
# scan fails on any fixed HIGH or CRITICAL finding. VERSION keys the layer, so
# every release upgrades anew instead of reusing a cached answer.
ARG VERSION=dev
RUN echo "upgrade layer: ${VERSION}" \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
COPY sandbox/requirements.lock /tmp/requirements.lock
COPY sandbox/loomcharts/ /tmp/loomcharts/
# Hash-pinned wheels only; no pip at run time, so pip goes once they are in
# (its vendored libraries are the base image's, and the release scan flags
# them). loomcharts, loom's chart module, goes into site-packages next to them:
# jobs run with -I, so only the default sys.path reaches it. compileall writes
# the .pyc files now, because jobs run with -B on a read-only root. Both paths
# come from the interpreter: a hard-coded python3.X dir outlived a base image
# bump once and compileall skipped the missing dir without failing.
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements.lock \
    && pip uninstall -y pip \
    && rm /tmp/requirements.lock \
    && site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
    && mv /tmp/loomcharts "$site/loomcharts" \
    && rm -rf "$site/loomcharts/__pycache__" \
    && chmod -R a+rX "$site/loomcharts" \
    && python -m compileall -q "$(python -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')"
COPY --from=fonts /out/fonts/ /usr/share/fonts/truetype/loom/
# /opt/mplconfig is copied into each job's home: its matplotlibrc (loomcharts'
# STYLE) makes loom's chart style every chart's default, and the prebuilt font
# cache saves each run the font scan. The rc goes in first so the cache sees the
# fonts. The loomcharts self-test draws every chart (building the cache on the
# way), checks the rc is the one matplotlib read and the font resolves, and fails
# the build otherwise.
RUN MPLCONFIGDIR=/tmp/mplrc python -I -B -m loomcharts.rc /opt/mplconfig/matplotlibrc \
    && rm -rf /tmp/mplrc \
    && MPLCONFIGDIR=/opt/mplconfig MPLBACKEND=Agg python -I -B -m loomcharts.selftest --rc /opt/mplconfig/matplotlibrc \
    && chmod -R a+rX /opt/mplconfig /usr/share/fonts/truetype/loom
# No setuid or setgid programs (su, mount, passwd): jobs run with no_new_privs
# anyway, this removes the targets.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +
COPY --from=build /out/loom-sandbox /loom-sandbox
EXPOSE 8070
ENTRYPOINT ["/loom-sandbox"]
CMD ["serve"]
