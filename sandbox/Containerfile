# syntax=docker/dockerfile:1
# Code sandbox for loom's run_python tool. Build from the repository root:
#   docker build -f sandbox/Containerfile -t loom-sandbox .
# A plain container (default runtime, nothing on the host); see compose.yaml.

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-sandbox/ ./cmd/loom-sandbox/
# ship release passes the release version. go build fetches only the modules
# this binary imports (golang.org/x/sys and kit), not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-sandbox ./cmd/loom-sandbox

FROM python:3.13-slim
# upgrade: the base image lags Debian's security fixes, and the release's trivy
# scan fails on any fixed HIGH or CRITICAL finding. VERSION keys the layer, so
# every release upgrades anew instead of reusing a cached answer.
ARG VERSION=dev
RUN echo "upgrade layer: ${VERSION}" \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
COPY sandbox/requirements.lock /tmp/requirements.lock
# Hash-pinned wheels only; no pip at run time. compileall writes the .pyc files
# now, because jobs run with -B on a read-only root.
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock \
    && python -m compileall -q /usr/local/lib/python3.13
# Prebuilt matplotlib font cache; each job gets a copy in its home.
RUN MPLCONFIGDIR=/opt/mplconfig MPLBACKEND=Agg python -c "import matplotlib.pyplot as plt; plt.figure()" \
    && chmod -R a+rX /opt/mplconfig
# No setuid or setgid programs (su, mount, passwd): jobs run with no_new_privs
# anyway, this removes the targets.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +
COPY --from=build /out/loom-sandbox /loom-sandbox
EXPOSE 8070
ENTRYPOINT ["/loom-sandbox"]
CMD ["serve"]
