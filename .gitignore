# Brainstorming visual companion artifacts
.superpowers/

# Node / frontend
# No trailing slash: also ignore a stray `node_modules` symlink/file, not just the
# directory (a tracked self-referential symlink here once broke fresh `npm` installs).
node_modules
*.tsbuildinfo

# Go
/loom
/backend/loom
/backend/loom-*
/bin/

# Python bytecode (a local py_compile of sandbox/loomcharts)
__pycache__/
*.test

# Coverage reports
/coverage/
/ui/coverage/

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
.zed/

# Codex (local, machine-specific)
.codex/
.worktrees/

# Local agent/browser tooling (machine-specific)
.claude/
.agents/
.playwright-mcp/

# Local data & secrets
*.db
*.db-*
.env
.env.*
!.env.example
data/
tunewire-data/
strava-data/
logs/

# Local MCP server overrides (real file; example is tracked)
conf/mcp.json

# ship:begin (owned by ship init; the repo's own lines go above the begin marker)
# What the gate and the UI build write into the tree.
coverage/ui/
ui/node_modules/
ui/*.tsbuildinfo
# The UI build the Go binary embeds; .gitkeep stays tracked so go:embed's dir exists in a fresh clone.
backend/web/dist/*
!backend/web/dist/.gitkeep
# ship:end
