# syntax=docker/dockerfile:1

# --- Stage 1: build the SPA ---
FROM node:26-alpine AS ui
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# --- Stage 2: build the Go API binary (pure-Go, no cgo) with the embedded SPA ---
FROM golang:1.27-alpine AS build
ARG BACKEND_VERSION=dev
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
# Overwrite the committed backend/web/dist placeholder with the real Vite bundle
# so //go:embed all:dist bakes the production UI into the binary.
COPY --from=ui /app/ui/dist ./web/dist
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${BACKEND_VERSION}" -o /out/loom ./cmd/loom

# --- Stage 3: minimal runtime ---
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom /loom
EXPOSE 8080
ENTRYPOINT ["/loom"]
