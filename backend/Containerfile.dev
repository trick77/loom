# syntax=docker/dockerfile:1
#
# Dev-only backend image. Builds JUST the Go binary and skips the frontend build
# stage of backend/Containerfile. The tracked backend/web/dist/.gitkeep satisfies
# //go:embed all:dist, so the binary compiles and serves kit's "UI not built"
# placeholder on :8080 — the real UI runs separately via Vite/HMR:
#
#   docker compose -f compose.dev.yaml -f compose.dev-uihmr.yaml up --build --remove-orphans
#   cd ui && npm run dev              # real UI with hot-reload on http://localhost:5173
#
# Unlike this dev image, the production backend image in backend/Containerfile
# builds the frontend and embeds the real UI, so it serves both API and SPA.

# --- Stage 1: build the Go binary (pure-Go, no cgo) ---
FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom ./cmd/loom

# --- Stage 2: minimal runtime ---
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom /loom
EXPOSE 8080
ENTRYPOINT ["/loom"]
