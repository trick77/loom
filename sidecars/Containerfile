# syntax=docker/dockerfile:1
# loom's Go sidecars in one image: docgen, imagegen, search, strava, tunewire,
# weather (docs/<name>.md). One build, scan and signature per release instead
# of six; each still runs as its own container, the binary picked by compose's
# command. Build from the repository root:
#   docker build -f sidecars/Containerfile -t loom-sidecars .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-docgen/ ./cmd/loom-docgen/
COPY backend/cmd/loom-imagegen/ ./cmd/loom-imagegen/
COPY backend/cmd/loom-search/ ./cmd/loom-search/
COPY backend/cmd/loom-strava/ ./cmd/loom-strava/
COPY backend/cmd/loom-tunewire/ ./cmd/loom-tunewire/
COPY backend/cmd/loom-weather/ ./cmd/loom-weather/
# What they import of loom: docgen's generators, Gotenberg client and embedded
# fonts; imagegen's fal client, the source-image reader and the inference log
# lines; for all, the token rule loom checks its side with (sidecar) and the
# user header (loomuser). The MCP server is github.com/trick77/toolkit's.
COPY backend/internal/docgen/ ./internal/docgen/
COPY backend/internal/imagegen/ ./internal/imagegen/
COPY backend/internal/imagescale/ ./internal/imagescale/
COPY backend/internal/inference/ ./internal/inference/
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. One go build for all six shares the
# compile of kit, toolkit and sidecar, and fetches only the modules they import,
# not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/ \
      ./cmd/loom-docgen \
      ./cmd/loom-imagegen \
      ./cmd/loom-search \
      ./cmd/loom-strava \
      ./cmd/loom-tunewire \
      ./cmd/loom-weather \
    && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-* /
# /data holds strava's and tunewire's state (the others mount nothing). Owned
# by the nonroot uid 65532 here: that covers a named volume (dev); a host bind
# mount (production) hides it, so the host dir must be chowned to 65532 itself,
# or serve refuses to start.
COPY --from=build --chown=65532:65532 /out/data /data
# The nonroot uid, never 1000.
USER 65532:65532
# No entrypoint and no EXPOSE: each compose service runs its own binary, e.g.
# command: ["/loom-weather", "serve"], on its own port.
