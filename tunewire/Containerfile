# syntax=docker/dockerfile:1
# Apple Music sidecar for loom (docs/tunewire.md). Build from the repository root:
#   docker build -f tunewire/Containerfile -t loom-tunewire .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-tunewire/ ./cmd/loom-tunewire/
# sidecar: the token rule and the bearer-token root (imports only loomuser);
# loomuser: the user header. Nothing else of loom. The MCP server is
# github.com/trick77/toolkit's.
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. go build fetches only the modules
# this binary imports (kit), not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-tunewire ./cmd/loom-tunewire \
    && mkdir -p /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-tunewire /loom-tunewire
# /data holds the token file. Owned by the nonroot uid 65532 here: that covers
# a named volume (dev); a host bind mount (production) hides it, so the host
# dir must be chowned to 65532 itself, or serve refuses to start.
COPY --from=build --chown=65532:65532 /out/data /data
USER 65532:65532
EXPOSE 8060
ENTRYPOINT ["/loom-tunewire"]
CMD ["serve"]
