# syntax=docker/dockerfile:1
# Weather sidecar for loom (docs/weather.md). Build from the repository root:
#   docker build -f weather/Containerfile -t loom-weather .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-weather/ ./cmd/loom-weather/
# The token rule loom checks its side with and the bearer-token root. The MCP
# server is github.com/trick77/toolkit's.
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. go build fetches only the modules
# this binary imports, not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-weather ./cmd/loom-weather

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-weather /loom-weather
# Stateless: no /data. The nonroot uid, never 1000.
USER 65532:65532
EXPOSE 8100
ENTRYPOINT ["/loom-weather"]
CMD ["serve"]
