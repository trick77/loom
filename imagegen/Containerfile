# syntax=docker/dockerfile:1
# Image generation sidecar for loom (docs/imagegen.md). Build from the repository root:
#   docker build -f imagegen/Containerfile -t loom-imagegen .

FROM golang:1.27-alpine AS build
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd/loom-imagegen/ ./cmd/loom-imagegen/
# The image service and fal client, plus what they import of loom: the
# source-image reader (proportions of an edit) and the inference log lines.
# The MCP server is github.com/trick77/toolkit's.
COPY backend/internal/imagegen/ ./internal/imagegen/
COPY backend/internal/imagescale/ ./internal/imagescale/
COPY backend/internal/inference/ ./internal/inference/
# The token rule loom checks its side with and the bearer-token root.
COPY backend/internal/sidecar/ ./internal/sidecar/
COPY backend/internal/loomuser/ ./internal/loomuser/
# ship release passes the release version. go build fetches only the modules
# this binary imports, not all of loom's.
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/loom-imagegen ./cmd/loom-imagegen

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/loom-imagegen /loom-imagegen
# Stateless: no /data. The nonroot uid, never 1000.
USER 65532:65532
EXPOSE 8040
ENTRYPOINT ["/loom-imagegen"]
CMD ["serve"]
